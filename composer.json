{
  "name": "rafyco/avatar-menu",
  "description": "A WordPress plugin to display the logged-in user's avatar and name.",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=7.2",
    "composer/installers": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "RafyCo\\AvatarMenu\\": "includes/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "composer dump-autoload"
    ]
  },
  "config": {
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
